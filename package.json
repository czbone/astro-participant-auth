{
  "name": "astro-participant-auth",
  "description": "Authentication skeleton for a WebAuthn participant app",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "exports": {
    ".": "./src/index.ts",
    "./integration": "./src/integration.ts",
    "./middleware": "./src/middleware/index.ts",
    "./layout": "./src/layouts/MainLayout.astro",
    "./env-check": "./src/server/env-check.ts"
  },
  "scripts": {
    "prepare": "prisma generate",
    "db:generate": "prisma generate",
    "db:ensure-test": "node scripts/ensure-test-db.mjs",
    "format": "prettier -w .",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run --project unit && vitest run --project integration"
  },
  "peerDependencies": {
    "astro": "^7.4.1",
    "hono": "^4.13.13"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.72.0",
    "astro": "^7.4.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "hono": "^4.13.14",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
